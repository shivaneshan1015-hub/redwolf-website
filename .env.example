# Redwolf Digital Site Environment Variables
NEXT_PUBLIC_SITE_URL=https://redwolf.in
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# -----------------------------------------------------------------------------
# Persistent Lead Storage Configuration
# -----------------------------------------------------------------------------
# Required for production (Vercel) lead persistence.
# In local development, defaults to data/leads.json when unset.
# In production, writes to local disk are disallowed for reliability.

# Option 1: Supabase PostgreSQL (Recommended)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Option 2: Webhook / External CRM Dispatch
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Lead Management Security & Access Control
# -----------------------------------------------------------------------------
# Secret token required to retrieve lead records via GET /api/enquiries
# Pass via Authorization: Bearer <ADMIN_API_KEY> header
ADMIN_API_KEY=
